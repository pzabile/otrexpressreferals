# SQLite for local dev. Swap to PostgreSQL for production by changing the
# provider in prisma/schema.prisma and using a postgres:// URL here.
DATABASE_URL="file:./dev.db"

# Admin credentials. The first time the app starts, an admin user is
# provisioned from these values. Change them before deploying.
ADMIN_EMAIL="admin@otrexpressgroup.com"
ADMIN_PASSWORD="change-me-now"

# 32+ character random string used to sign admin session cookies.
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Base URL used in status-check links shown to referrers.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payout amount shown to referrers (USD). Purely informational.
NEXT_PUBLIC_REFERRAL_BOUNTY="500"
